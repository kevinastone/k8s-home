{
  "format_on_save": "on",
  "formatter": {
    "external": {
      "command": "treefmt",
      "arguments": ["--stdin", "{buffer_path}"],
    },
  },
  "load_direnv": "direct",
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "customTags": [
            "!env_var scalar",
            "!secret scalar",
            "!file scalar"
          ]
        }
      }
    }
  }
}
