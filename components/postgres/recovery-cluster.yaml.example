# yaml-language-server: $schema=https://datreeio.github.io/CRDs-catalog/postgresql.cnpg.io/cluster_v1.json
# Standard CloudNativePG Recovery / Point-In-Time Recovery (PITR) Template
#
# Usage:
# 1. Copy this file into your app's postgres folder (e.g., apps/<app>/postgres/cluster-restored.yaml).
# 2. Update metadata.name (must be different from the existing cluster name, e.g. postgres-v2).
# 3. Configure spec.bootstrap.recovery and spec.externalClusters to point to the source ObjectStore.
# 4. (Optional) Set recoveryTarget for Point-in-Time Recovery (PITR).
# 5. Add to kustomization.yaml and commit.
# 6. Once verified, update the app to point to the new cluster and retire the old one.
#
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: postgres-restored
spec:
  instances: 3
  imageName: ghcr.io/cloudnative-pg/postgresql:19.0-minimal-trixie@sha256:12688a494f25aa0b7e1e3cd1800abe85b427fd1a09c991668a48162e3431a2af
  primaryUpdateStrategy: unsupervised
  primaryUpdateMethod: switchover
  affinity:
    podAntiAffinityType: required
  storage:
    size: 10Gi
    storageClass: openebs-rawfile
  walStorage:
    size: 1Gi
    storageClass: openebs-rawfile
  resources:
    requests:
      cpu: 200m
    limits:
      memory: 1Gi
  monitoring:
    enablePodMonitor: true
  replicationSlots:
    highAvailability:
      enabled: true

  # Recovery configuration
  bootstrap:
    recovery:
      source: s3-backup
      # Point-in-time recovery target (optional):
      # recoveryTarget:
      #   targetTime: "2026-11-06 07:00:00.000000+00"
      #   targetImmediate: false
      # Or restore to a specific base backup:
      #   backupName: "20261105T043000"

  # External cluster reference pointing to the Barman Cloud ObjectStore
  externalClusters:
    - name: s3-backup
      plugin:
        name: barman-cloud.cloudnative-pg.io
        parameters:
          # barmanObjectName must match the name of the barmancloud.cnpg.io/v1 ObjectStore in the namespace
          barmanObjectName: postgres
          # serverName corresponds to the directory inside the S3 bucket where backups/WALs reside
          serverName: postgres-v19

  postgresql:
    parameters:
      shared_buffers: 256MB
      max_connections: "20"
      max_slot_wal_keep_size: 256MB
      hot_standby_feedback: "on"
      wal_keep_size: 32MB
      max_wal_size: 256MB
      min_wal_size: 32MB

  # Uncomment once cutover is complete and you want this new cluster to begin archiving WALs to Barman
  # plugins:
  #   - name: barman-cloud.cloudnative-pg.io
  #     isWALArchiver: true
  #     parameters:
  #       barmanObjectName: postgres
  #       serverName: postgres-v19
