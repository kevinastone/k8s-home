{
    "title": "Alerts Single-Pane Overview",
    "uid": "alerts-single-pane",
    "schemaVersion": 39,
    "links": [
        {
            "title": "Alertmanager Silences",
            "tooltip": "Manage or create Alertmanager silences",
            "type": "link",
            "url": "/alerting/silences?alertmanager=Alertmanager"
        },
        {
            "title": "Alert Groups",
            "tooltip": "View grouped alerts in Alertmanager",
            "type": "link",
            "url": "/alerting/groups?alertmanager=Alertmanager"
        },
        {
            "title": "Notification Policies",
            "tooltip": "View Alertmanager routing tree",
            "type": "link",
            "url": "/alerting/routes?alertmanager=Alertmanager"
        }
    ],
    "liveNow": true,
    "panels": [
        {
            "title": "Critical Alerts",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "type": "stat",
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "graphMode": "none",
                "colorMode": "background"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "red"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "count(ALERTS{alertstate=\"firing\", severity=\"critical\"}) or vector(0)",
                    "legendFormat": "Critical",
                    "format": "time_series",
                    "instant": true
                }
            ]
        },
        {
            "title": "Warning Alerts",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "type": "stat",
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "graphMode": "none",
                "colorMode": "background"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "orange"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "count(ALERTS{alertstate=\"firing\", severity=\"warning\"}) or vector(0)",
                    "legendFormat": "Warning",
                    "format": "time_series",
                    "instant": true
                }
            ]
        },
        {
            "title": "Total Firing Alerts",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "type": "stat",
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "graphMode": "none",
                "colorMode": "background"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "semi-dark-yellow",
                                "value": 1
                            },
                            {
                                "color": "red",
                                "value": 5
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
                    "legendFormat": "Firing",
                    "format": "time_series",
                    "instant": true
                }
            ]
        },
        {
            "title": "Pending Alerts",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "type": "stat",
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "graphMode": "none",
                "colorMode": "background"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "yellow"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "count(ALERTS{alertstate=\"pending\"}) or vector(0)",
                    "legendFormat": "Pending",
                    "format": "time_series",
                    "instant": true
                }
            ]
        },
        {
            "title": "Active & Firing Alerts",
            "gridPos": {
                "h": 12,
                "w": 24,
                "x": 0,
                "y": 4
            },
            "type": "alertlist",
            "options": {
                "viewMode": "list",
                "groupMode": "default",
                "showInstances": true,
                "maxItems": 50,
                "sortOrder": 1,
                "stateFilter": {
                    "error": true,
                    "firing": true,
                    "pending": true,
                    "noData": false,
                    "normal": false,
                    "recovering": false
                }
            }
        },
        {
            "title": "Alert Timeline (Last 24 Hours)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 16
            },
            "type": "state-timeline",
            "options": {
                "showValue": "auto",
                "mergeValues": true,
                "rowHeight": 0.8,
                "alignValue": "left",
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "legend": {
                    "showLegend": true,
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "fillOpacity": 70,
                        "lineWidth": 0
                    },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "color": "green",
                                    "index": 0,
                                    "text": "Inactive"
                                },
                                "1": {
                                    "color": "red",
                                    "index": 1,
                                    "text": "Firing"
                                }
                            }
                        }
                    ]
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "ALERTS{alertstate=\"firing\"}",
                    "legendFormat": "{{alertname}} ({{namespace}})",
                    "format": "time_series",
                    "instant": false
                }
            ]
        }
    ],
    "refresh": "10s",
    "tags": [
        "alerts",
        "alertmanager",
        "victoria-metrics"
    ],
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timepicker": {
        "refresh_intervals": [
            "5s",
            "10s",
            "30s",
            "1m",
            "5m"
        ]
    }
}
