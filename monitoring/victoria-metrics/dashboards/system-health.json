{
    "title": "System Health",
    "uid": "system-health",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "schemaVersion": 42,
    "panels": [
        {
            "type": "row",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 0,
            "panels": [],
            "title": "CPU Usage"
        },
        {
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "celsius",
                    "mappings": [],
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "spanNulls": 3600000,
                        "fillOpacity": 0
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 1
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true,
                    "calcs": []
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "avg by(host) (host.temperature_celsius{host=~\"$host\"})",
                    "legendFormat": "__auto",
                    "format": "time_series",
                    "instant": false
                }
            ],
            "title": "CPU Temperature"
        },
        {
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "mappings": [],
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "spanNulls": 3600000,
                        "fillOpacity": 0
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 1
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true,
                    "calcs": []
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "100 * (sum by(host) (rate(host.cpu_seconds_total{host=~\"$host\",mode!~\"idle|iowait\"}[$__rate_interval])) / sum by(host) (rate(host.cpu_seconds_total{host=~\"$host\"}[$__rate_interval])))",
                    "legendFormat": "__auto",
                    "format": "time_series",
                    "instant": false
                }
            ],
            "title": "CPU Usage"
        },
        {
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "spanNulls": 3600000,
                        "fillOpacity": 0
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 10
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true,
                    "calcs": []
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "avg by(host) (host.load1{host=~\"$host\"})",
                    "legendFormat": "__auto",
                    "format": "time_series",
                    "instant": false
                }
            ],
            "title": "Load 1"
        },
        {
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "spanNulls": 3600000,
                        "fillOpacity": 0
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 10
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true,
                    "calcs": []
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "expr": "avg by(host) (host.load5{host=~\"$host\"})",
                    "legendFormat": "__auto",
                    "format": "time_series",
                    "instant": false
                }
            ],
            "title": "Load 5"
        },
        {
            "type": "gauge",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 7,
                "w": 24,
                "x": 0,
                "y": 19
            },
            "options": {
                "orientation": "auto",
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true,
                "sizing": "auto",
                "minVizWidth": 75,
                "minVizHeight": 75,
                "segmentCount": 1,
                "segmentSpacing": 0.3,
                "shape": "gauge",
                "barWidthFactor": 0.5,
                "barShape": "flat",
                "effects": {}
            },
            "targets": [
                {
                    "expr": "100 * avg by(host) (host.filesystem_used_ratio{host=~\"$host\"})",
                    "legendFormat": "__auto",
                    "format": "time_series",
                    "instant": false
                }
            ],
            "title": "Disk Used"
        }
    ],
    "templating": {
        "list": [
            {
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "definition": "label_values({__name__=~\"host.*\"}, host)",
                "includeAll": true,
                "label": "Host",
                "multi": true,
                "name": "host",
                "query": {
                    "query": "label_values({__name__=~\"host.*\"}, host)",
                    "refId": "StandardVariableQuery"
                },
                "refresh": 1,
                "sort": 1,
                "type": "query"
            }
        ]
    }
}
