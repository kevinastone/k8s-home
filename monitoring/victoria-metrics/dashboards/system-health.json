                "label": "Host",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": {
                    "query": "label_values({__name__=~\"telegraf_.*\"}, host)",
                    "refId": "StandardVariableQuery"
                },
                "definition": "label_values({__name__=~\"telegraf_.*\"}, host)",
                "refresh": 1,
                "sort": 1,
                "includeAll": true,
                "multi": true
            }
