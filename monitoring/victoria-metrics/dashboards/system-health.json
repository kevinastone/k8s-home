{
    "title": "System Health",
    "uid": "system-health",
    "schemaVersion": 39,
    "panels": [
        {
            "title": "CPU Usage",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "type": "row",
            "panels": []
        },
        {
            "title": "CPU Temperature",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 1
            },
            "type": "timeseries",
            "options": {
                "alertThreshold": true,
                "legend": {
                    "calcs": [],
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "hideZeros": false,
                    "mode": "single",
                    "sort": "none"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "celsius",
                    "mappings": [],
                    "color": {
                        "mode": "palette-classic"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "spanNulls": 3600000,
                        "fillOpacity": 0,
                        "pointSize": 5,
                        "showPoints": "auto",
                        "axisPlacement": "auto",
                        "axisColorMode": "text",
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "avg by(host) (telegraf_temp_temp{host=~\"$host\"})",
                    "legendFormat": "__auto",
                    "format": "time_series",
                    "instant": false
                }
            ]
        },
