{
    "title": "System Health",
    "uid": "system-health",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "schemaVersion": 42,
    "panels": [
        {
            "type": "row",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 0,
            "panels": [],
            "title": "CPU Usage"
        },
        {
            "type": "timeseries",
            "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "clickhouse"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "celsius",
                    "mappings": [],
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "spanNulls": 3600000,
                        "fillOpacity": 0
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 1
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true,
                    "calcs": []
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "rawSql": "SELECT\n  toStartOfInterval(timestamp, INTERVAL $__interval_s SECOND) AS time,\n  host,\n  avg(value) AS value\nFROM metrics.telegraf\nWHERE $__timeFilter(timestamp)\n  AND name = 'host.temperature_celsius'\n  AND host IN ($host)\nGROUP BY time, host\nORDER BY time",
                    "queryType": "timeseries",
                    "format": 0,
                    "editorType": "sql",
                    "datasource": {
                        "type": "grafana-clickhouse-datasource",
                        "uid": "clickhouse"
                    }
                }
            ],
            "title": "CPU Temperature"
        },
        {
            "type": "timeseries",
            "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "clickhouse"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "mappings": [],
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "spanNulls": 3600000,
                        "fillOpacity": 0
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 1
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true,
                    "calcs": []
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "rawSql": "SELECT\n  time,\n  host,\n  100 * sumIf(rate, mode NOT IN ('idle', 'iowait')) / nullIf(sum(rate), 0) AS value\nFROM (\n  SELECT\n    toStartOfInterval(timestamp, INTERVAL $__interval_s SECOND) AS time,\n    host,\n    tags['mode'] AS mode,\n    nonNegativeDerivative(value, timestamp) OVER (\n      PARTITION BY host, tags['cpu'], tags['mode']\n      ORDER BY timestamp\n    ) AS rate\n  FROM metrics.telegraf\n  WHERE $__timeFilter(timestamp)\n    AND name = 'host.cpu_seconds_total'\n    AND host IN ($host)\n)\nGROUP BY time, host\nORDER BY time",
                    "queryType": "timeseries",
                    "format": 0,
                    "editorType": "sql",
                    "datasource": {
                        "type": "grafana-clickhouse-datasource",
                        "uid": "clickhouse"
                    }
                }
            ],
            "title": "CPU Usage"
        },
