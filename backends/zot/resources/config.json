{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "dedupe": false,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "6h",
    "remoteCache": true,
    "cacheDriver": {
      "name": "redis",
      "url": "redis://dragonfly:6379"
    },
    "storageDriver": {
      "name": "s3",
      "region": "us-east-1",
      "bucket": "zot",
      "regionendpoint": "https://s3.k8s.kevinastone.com",
      "forcepathstyle": true,
      "secure": true
    },
    "retention": {
      "policies": [
        {
          "repositories": ["**"],
          "deleteUntagged": true,
          "keepTags": [
            {
              "pulledWithin": "720h"
            }
          ]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": 5000,
    "compat": ["docker2s2"]
  },
  "log": {
    "level": "warn"
  },
  "extensions": {
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    },
    "sync": {
      "enable": true,
      "downloadDir": "/var/lib/zot/_sync",
      "registries": [
        {
          "urls": ["https://registry-1.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "platforms": ["linux/amd64"],
          "content": [
            {
              "prefix": "/**",
              "destination": "/dockerhub"
            }
          ]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "tlsVerify": true,
          "platforms": ["linux/amd64"],
          "content": [
            {
              "prefix": "/**",
              "destination": "/ghcr"
            }
          ]
        },
        {
          "urls": ["https://quay.io"],
          "onDemand": true,
          "tlsVerify": true,
          "platforms": ["linux/amd64"],
          "content": [
            {
              "prefix": "/**",
              "destination": "/quay"
            }
          ]
        },
        {
          "urls": ["https://registry.k8s.io"],
          "onDemand": true,
          "tlsVerify": true,
          "platforms": ["linux/amd64"],
          "content": [
            {
              "prefix": "/**",
              "destination": "/k8s"
            }
          ]
        },
        {
          "urls": ["https://lscr.io"],
          "onDemand": true,
          "tlsVerify": true,
          "platforms": ["linux/amd64"],
          "content": [
            {
              "prefix": "/**",
              "destination": "/lscr"
            }
          ]
        }
      ]
    }
  }
}
