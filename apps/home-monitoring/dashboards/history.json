{
    "title": "Sensor History",
    "uid": "home-history",
    "tags": [
        "home",
        "iot"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {
        "from": "now-24h",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "entity",
                "type": "textbox",
                "label": "Entity",
                "default": "bedroom_temperature_temperature",
                "current": {
                    "selected": false,
                    "text": "bedroom_temperature_temperature",
                    "value": "bedroom_temperature_temperature"
                },
                "hide": 2
            },
            {
                "name": "title",
                "type": "textbox",
                "label": "Title",
                "default": "Sensor",
                "current": {
                    "selected": false,
                    "text": "Sensor",
                    "value": "Sensor"
                },
                "hide": 2
            }
        ]
    },
    "panels": [
        {
            "title": "${title} History",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 20,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "type": "timeseries",
            "options": {
                "legend": {
                    "showLegend": true
                }
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "spanNulls": true,
                        "fillOpacity": 10
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*_°F_.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "fahrenheit"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*_%_.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "percent"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*_inHg_.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "inHg"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*_W_.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "watt"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*_kWh_.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "kwh"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*_V_.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "volt"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": ".*_A_.*"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "amp"
                            }
                        ]
                    }
                ]
            },
            "targets": [
                {
                    "expr": "{entity_id=\"${entity}\",__name__=~\".*_value\"}",
                    "legendFormat": "{{__name__}}",
                    "format": "time_series",
                    "instant": false
                }
            ]
        }
    ]
}
