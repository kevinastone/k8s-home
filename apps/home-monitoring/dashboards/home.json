        "list": []
    },
    "panels": [
        {
            "title": "Bedroom",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "type": "stat",
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "horizontal",
                "textMode": "value_and_name",
                "graphMode": "area"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 68
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Temperature"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "fahrenheit"
                            },
                            {
                                "id": "links",
                                "value": [
                                    {
                                        "targetBlank": false,
                                        "url": "/d/home-history?var-entity=bedroom_temperature_temperature&var-title=Bedroom Temperature&var-unit=fahrenheit",
                                        "title": "Bedroom Temperature"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Humidity"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "percent"
                            },
                            {
                                "id": "links",
                                "value": [
                                    {
                                        "targetBlank": false,
                                        "url": "/d/home-history?var-entity=bedroom_temperature_humidity&var-title=Bedroom Humidity&var-unit=percent",
                                        "title": "Bedroom Humidity"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Pressure"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "inHg"
                            },
                            {
                                "id": "links",
                                "value": [
                                    {
                                        "targetBlank": false,
                                        "url": "/d/home-history?var-entity=bedroom_temperature_pressure&var-title=Bedroom Pressure&var-unit=inHg",
                                        "title": "Bedroom Pressure"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            "targets": [
                {
                    "expr": "{entity_id=\"bedroom_temperature_temperature\",__name__=~\".*_value\"}",
                    "legendFormat": "Temperature",
                    "format": "time_series",
                    "instant": false
                },
                {
                    "expr": "{entity_id=\"bedroom_temperature_humidity\",__name__=~\".*_value\"}",
                    "legendFormat": "Humidity",
                    "format": "time_series",
                    "instant": false
                },
                {
                    "expr": "{entity_id=\"bedroom_temperature_pressure\",__name__=~\".*_value\"}",
                    "legendFormat": "Pressure",
                    "format": "time_series",
                    "instant": false
                }
            ]
