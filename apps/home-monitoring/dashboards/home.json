{
    "title": "Home",
    "uid": "home-overview",
    "tags": [
        "home",
        "iot"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {
        "from": "now-24h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "title": "Bedroom",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "type": "stat",
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "horizontal",
                "textMode": "value_and_name",
                "graphMode": "area",
                "colorMode": "none"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": []
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Temperature"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "fahrenheit"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Humidity"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "percent"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Pressure"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "inHg"
                            }
                        ]
                    }
                ]
            },
            "targets": [
                {
                    "expr": "last_over_time({entity_id=\"bedroom_temperature_temperature\",__name__=~\".*_value\"}[2h])",
                    "legendFormat": "Temperature",
                    "format": "time_series",
                    "instant": false
                },
                {
                    "expr": "last_over_time({entity_id=\"bedroom_temperature_humidity\",__name__=~\".*_value\"}[2h])",
                    "legendFormat": "Humidity",
                    "format": "time_series",
                    "instant": false
                },
                {
                    "expr": "last_over_time({entity_id=\"bedroom_temperature_pressure\",__name__=~\".*_value\"}[2h])",
                    "legendFormat": "Pressure",
                    "format": "time_series",
                    "instant": false
                }
            ]
        },
        {
            "title": "Bedroom Temperature History",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 5
            },
            "type": "timeseries",
            "options": {
                "legend": {
                    "showLegend": false
                }
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "spanNulls": true,
                        "fillOpacity": 10
                    },
                    "unit": "fahrenheit"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "last_over_time({entity_id=\"bedroom_temperature_temperature\",__name__=~\".*_value\"}[2h])",
                    "legendFormat": "Bedroom",
                    "format": "time_series",
                    "instant": false
                }
            ]
        },
