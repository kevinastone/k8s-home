                "textMode": "value_and_name",
                "wideLayout": true,
                "showPercentChange": false,
                "percentChangeColorMode": "standard"
            },
            "targets": [
                {
                    "rawSql": "SELECT\n  toStartOfInterval(timestamp, INTERVAL $__interval_s SECOND) AS time,\n  avgIf(value, name = 'temperature') * 9 / 5 + 32 AS Temperature,\n  avgIf(value, name = 'humidity') AS Humidity,\n  avgIf(value, name = 'pressure') * 0.02952998 AS Pressure\nFROM metrics.zigbee2mqtt\nWHERE $__timeFilter(timestamp)\n  AND entity_id = 'bedroom_temperature'\n  AND name IN ('temperature', 'humidity', 'pressure')\nGROUP BY time\nORDER BY time",
                    "queryType": "timeseries",
                    "format": 0,
                    "editorType": "sql",
                    "datasource": {
                        "type": "grafana-clickhouse-datasource",
                        "uid": "clickhouse"
                    }
                }
            ],
            "title": "Bedroom"
        },
