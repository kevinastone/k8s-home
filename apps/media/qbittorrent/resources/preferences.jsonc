{
  // Global and per-torrent peer connection limits
  "max_connec": 1000,
  "max_connec_per_torrent": 150,

  // Monitored folders: 1 = download to default save location (/incoming)
  "scan_dirs": {
    "/incoming": 1
  },

  // Swarm discovery & multi-tracker announcing
  "announce_to_all_tiers": true,
  "announce_to_all_trackers": true,
  "add_trackers_enabled": true,
  "add_trackers": "udp://tracker.opentrackr.org:1337/announce\nudp://open.stealth.si:80/announce\nudp://tracker.torrent.eu.org:451/announce\nudp://tracker.bittor.pw:1337/announce\nudp://public.popcorn-tracker.org:6969/announce\nudp://tracker.dler.org:6969/announce\nudp://exodus.desync.com:6969/announce\nudp://open.demonii.com:1337/announce"
}
