{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    "docker:enableMajor",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": ["**/resources/**"],
  "pinDigest": {
    "automerge": true
  },
  "flux": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)workflow-template\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*[\"']?(?<depName>[^\\s\"':@]+):(?<currentValue>[^\\s\"':@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "autoReplaceStringTemplate": "image: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track GitHub release asset URLs in Kustomize manifests",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>[^/\\s]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track CloudNativePG Cluster images",
      "managerFilePatterns": [
        "/(^|/)cluster.*\\.ya?ml$",
        "/postgres/.*\\.ya?ml$"
      ],
      "matchStrings": [
        "imageName:\\s*[\"']?(?<depName>[^\\s\"':@]+):(?<currentValue>[^\\s\"':@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "autoReplaceStringTemplate": "imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["csi-driver-smb"],
      "allowedVersions": "!/v1.15.0/"
    },
    {
      "matchPackageNames": ["ghcr.io/dmunozv04/isponsorblocktv"],
      "allowedVersions": "!/v2.5.2/"
    },
    // Block broken ws4kp versions due to env parsing bug (https://github.com/netbymatt/ws4kp/issues/122)
    {
      "matchPackageNames": ["ghcr.io/netbymatt/ws4kp"],
      "allowedVersions": "<5.25.2 || >=6.0.0"
    },
    {
      "description": ["qbit_manage is not yet compatible with qbittorrent > 5.2.4"],
      "matchPackageNames": ["ghcr.io/home-operations/qbittorrent"],
      "allowedVersions": "<=5.2.4"
    },
    {
      "description": [
        "Block opentofu-runner digest updates incompatible with tofu-controller v0.16.6"
      ],
      "matchPackageNames": ["ghcr.io/home-operations/opentofu-runner"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "description": ["CalVer for Cloudflared"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cloudflare/cloudflared"],
      "automerge": true
    },
    {
      "description": ["CalVer for Home-Assistant"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-assistant/home-assistant"],
      "automerge": true
    },
    {
      "description": ["Use OpenTofu registry for terraform providers and modules"],
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "matchPackageNames": ["ghcr.io/kevinastone/ffmpeg"],
      "versioning": "semver-coerced"
    },
    {
      "description": ["Pin digests for docker container images"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": ["Don't pin digests for managers that don't need a digest"],
      "matchManagers": ["flux", "helmfile"],
      "pinDigests": false
    },
    {
      "description": ["Group Envoy Gateway controller and CRD updates"],
      "matchPackageNames": [
        "docker.io/envoyproxy/gateway-helm",
        "envoyproxy/gateway-helm",
        "envoy-gateway-crds",
        "envoyproxy/gateway",
        "https://github.com/envoyproxy/gateway",
        "/envoyproxy/gateway/"
      ],
      "groupName": "envoy-gateway"
    },
    {
      "description": ["Group cert-manager controller and CRD updates"],
      "matchPackageNames": [
        "quay.io/jetstack/charts/cert-manager",
        "jetstack/charts/cert-manager",
        "cert-manager-crds",
        "cert-manager/cert-manager",
        "https://github.com/cert-manager/cert-manager",
        "/cert-manager/"
      ],
      "groupName": "cert-manager"
    }
  ]
}
