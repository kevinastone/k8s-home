{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":skipStatusChecks",
    "docker:enableMajor"
  ],
  "flux": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "packageRules": [
    {
      "matchCurrentVersion": "v3.3.0",
      "matchPackagePatterns": ["redis-operator"],
      "enabled": false
    },
    {
      "matchCurrentVersion": "v7.3.2",
      "matchPackagePatterns": ["grafana"],
      "enabled": false
    },
    {
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["cloudflared"],
      "pinDigests": true,
      "automerge": true
    }
  ]
}
