{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":skipStatusChecks",
    "docker:enableMajor",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": ["**/resources/**"],
  "flux": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["redis-operator"],
      "allowedVersions": "!/3.3.0/"
    },
    {
      "matchPackagePatterns": ["grafana"],
      "allowedVersions": "!/7.3.2/"
    },
    {
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["*"],
       "excludePackagePatterns": ["ghcr.io/prometheus-community/charts", "registry-1.docker.io/envoyproxy/gateway-helm", "registry-1.docker.io/bitnamicharts/minio"],
      "pinDigests": true
    }
  ]
}
