{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    ":semanticCommits",
    ":automergePatch",
    ":rebaseStalePrs",
    "docker:enableMajor"
  ],
  "flux": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "packageRules": [{
    "matchPackagePatterns": ["redis-operator", "grafana"],
    "automerge": false,
    "updateTypes": ["minor", "patch", "pin", "digest"]
  }]
}
