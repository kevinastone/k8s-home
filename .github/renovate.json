{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":skipStatusChecks",
    "docker:enableMajor"
  ],
  "flux": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["redis-operator"],
      "allowedVersions": "!/v3.3.0/"
    },
    {
      "matchPackagePatterns": ["grafana"],
      "allowedVersions": "!/v7.3.2/"
    },
    {
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["zigbee2mqtt", "ldap", "prometheus"],
       "excludePackagePatterns": ["mosquitto", "prometheus", "gateway-helm"],
      "pinDigests": true,
      "automerge": true
    }
  ]
}
