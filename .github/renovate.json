{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":skipStatusChecks",
    "docker:enableMajor",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": ["**/resources/**"],
  "flux": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["redis-operator"],
      "allowedVersions": "!/3.3.0/"
    },
    {
      "matchPackagePatterns": ["prometheus-snmp-exporter"],
      "allowedVersions": "!/3.1.0/"
    },
    {
      "matchPackagePatterns": ["minio"],
      "allowedVersions": "<=13.7.0"
    },
    {
      "matchPackagePatterns": ["kubernetes-dashboard"],
      "allowedVersions": "<7"
    },
    {
      "matchPackagePatterns": ["kube-prometheus-stack"],
      "allowedVersions": "!/57.2.0/"
    },
    {
      "matchPackagePatterns": ["descheduler"],
      "allowedVersions": "!/0.30.0/"
    },
    {
      "matchPackagePatterns": ["csi-driver-smb"],
      "allowedVersions": "!/v1.15.0/"
    },
    {
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["*"],
       "excludePackagePatterns": ["registry-1.docker.io/envoyproxy/gateway-helm", "registry-1.docker.io/bitnamicharts/minio"],
      "pinDigests": true
    },
    {
      "description": ["CalVer for Home-Assistant"],
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["home-assistant"],
      "automerge": true
    }
  ]
}
