{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":skipStatusChecks",
    "docker:enableMajor",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": ["**/resources/**"],
  "flux": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["redis-operator"],
      "allowedVersions": "!/3.3.0/"
    },
    {
      "matchPackagePatterns": ["kubernetes-dashboard"],
      "allowedVersions": "<7"
    },
    {
      "matchPackagePatterns": ["csi-driver-smb"],
      "allowedVersions": "!/v1.15.0/"
    },
    {
      "matchPackagePatterns": ["promtail"],
      "allowedVersions": "!/6.16.0/"
    },
    {
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["*"],
      "excludePackagePatterns": [
        "docker.io/envoyproxy/gateway-helm",
        "docker.io/bitnamicharts/minio",
        "ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator"
      ],
      "pinDigests": true
    },
    {
      "description": ["CalVer for Home-Assistant"],
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["home-assistant"],
      "automerge": true
    }
  ]
}
