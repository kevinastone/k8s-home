{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":skipStatusChecks",
    "docker:enableMajor"
  ],
  "flux": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["redis-operator"],
      "versioning": "semver",
      "allowedVersions": "!/3.3.0/"
    },
    {
      "matchPackagePatterns": ["grafana"],
      "versioning": "semver",
      "allowedVersions": "!/7.3.2/"
    },
    {
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["*"],
       "excludePackagePatterns": ["prometheus", "gateway-helm", "registry-1.docker.io/bitnamicharts/minio"],
      "pinDigests": true,
      "automerge": true
    }
  ]
}
