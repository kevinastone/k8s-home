{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":skipStatusChecks",
    "docker:enableMajor",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": [
    "**/resources/**"
  ],
  "flux": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "helm-values": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "allowedVersions": "!/3.3.0/",
      "matchPackageNames": [
        "/redis-operator/"
      ]
    },
    {
      "allowedVersions": "<7",
      "matchPackageNames": [
        "/kubernetes-dashboard/"
      ]
    },
    {
      "allowedVersions": "!/v1.15.0/",
      "matchPackageNames": [
        "/csi-driver-smb/"
      ]
    },
    {
      "allowedVersions": "!/6.16.0/",
      "matchPackageNames": [
        "/promtail/"
      ]
    },
    {
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "matchPackageNames": [
        "*",
        "!/docker.io/envoyproxy/gateway-helm/",
        "!/docker.io/bitnamicharts/minio/",
        "!/ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator/"
      ]
    },
    {
      "description": [
        "CalVer for Home-Assistant"
      ],
      "matchDatasources": [
        "docker"
      ],
      "automerge": true,
      "matchPackageNames": [
        "/home-assistant/"
      ]
    }
  ]
}
