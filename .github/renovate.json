{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":skipStatusChecks",
    "docker:enableMajor",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": ["**/resources/**"],
  "flux": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["redis-operator"],
      "allowedVersions": "!/3.3.0/"
    },
    {
      "matchPackageNames": ["kubernetes-dashboard"],
      "allowedVersions": "<7"
    },
    {
      "matchPackageNames": ["csi-driver-smb"],
      "allowedVersions": "!/v1.15.0/"
    },
    {
      "matchPackageNames": ["promtail"],
      "allowedVersions": "!/6.16.0/"
    },
    {
      "matchPackageNames": ["descheduler"],
      "allowedVersions": "!/0.32.0/"
    },
    {
      "matchDatasources": ["kubernetes-api"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "!docker.io/envoyproxy/gateway-helm",
        "!docker.io/bitnamicharts/minio",
        "!ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator"
      ],
      "pinDigests": true
    },
    {
      "description": ["CalVer for Cloudflared"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cloudflare/cloudflared"],
      "automerge": true
    },
    {
      "description": ["CalVer for Home-Assistant"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-assistant/home-assistant"],
      "automerge": true
    }
  ]
}
